# URL del mapa al que apuntan los botones "Abrir el mapa" (por defecto /mapa/)
VITE_MAP_URL=

# URL del backend (wawhere-api). Vacío = mismo origen; en dev lo resuelve el proxy de Vite
VITE_API_URL=

# Estilo de MapLibre (por defecto OpenFreeMap positron, sin API key)
VITE_MAP_STYLE_URL=

# Debe coincidir con REPORT_EXPIRY_HOURS del backend (por defecto 24)
VITE_REPORT_EXPIRY_HOURS=
